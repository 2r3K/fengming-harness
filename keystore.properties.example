# ============================================================
# 正式签名配置的模板
#
# 用法：
#   1. 把这个文件复制成 keystore.properties（同目录）
#   2. 用你自己的证书替换下面三行的值
#   3. keystore.properties 已经在 .gitignore 里，别提交它
#
# 没有 keystore.properties 也能正常构建（只是打出来的包没有正式签名）
# ============================================================

# 证书文件路径（相对项目根目录，或者写绝对路径）
storeFile=keystore/your-release.jks

# 证书库密码
storePassword=change-me

# 证书别名
keyAlias=your-alias

# 别名对应的密码
keyPassword=change-me
